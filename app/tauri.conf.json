{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mirrormyiphone",
  "version": "1.0.0",
  "identifier": "com.meekwilliam.mirrormyiphone",
  "build": {
    "frontendDist": "web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mirrormyiphone",
        "width": 440,
        "height": 900,
        "minWidth": 300,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "William Meek",
    "copyright": "Copyright © 2026 William Meek. MIT License.",
    "shortDescription": "Your iPhone's screen, live, on your computer",
    "longDescription": "Shows a connected iPhone's screen live in a window, and lets you tap, swipe and press its buttons with the mouse. Nothing is installed on the iPhone."
  }
}
